# CapMonster Cloud ONLY (do not use RoRush NoneCap / 2Captcha keys here)
# Leave unset until rain bot runs; do not use an empty CAPMONSTER_API_KEY= line
CAPMONSTER_API_KEY=

# 32-byte AES key, base64 (openssl rand -base64 32) — encrypts stored session cookies
ENCRYPTION_KEY=

# Raw session paste uses cookie name SID by default; override if DevTools shows another name
# GOLDPUMP_SESSION_COOKIE_NAME=connect.sid

# Required on many VPS hosts — Cloudflare blocks datacenter IPs (residential/ISP proxy)
# GOLDPUMP_PROXY_URL=http://user:pass@host:port

GOLDPUMP_API_BASE=https://api.goldpump.com
GOLDPUMP_SITE_URL=https://goldpump.com/
GOLDPUMP_TURNSTILE_SITEKEY=0x4AAAAAACLmkLF8v68bkhrE

# Optional HTTP(S) proxy for GoldPump traffic (rain join, limbo wager)
GOLDPUMP_PROXY_URL=

DATABASE_PATH=./data/goldpump-automation.db

# After rain payout, limbo-bet this fraction of balance (0 = off). Rain winnings must be wagered before the next join.
AUTO_WAGER_LIMBO_FRACTION=0
LIMBO_MULTIPLIER=2
MIN_LIMBO_BET=1

LOG_LEVEL=info
